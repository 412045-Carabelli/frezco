# Copiar a .env y completar. El archivo .env no se versiona.

# Base de datos (instancia SQL Server compartida del VPS, base propia de este sistema)
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=frezco
DB_USER=sa
DB_PASSWORD=

# Credenciales de la aplicación (usuario único, sin tabla de usuarios)
APP_USER=admin
APP_PASSWORD=

# Puertos publicados en el host
BACKEND_PORT=8090
FRONTEND_PORT=4300
