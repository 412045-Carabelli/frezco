# Si viene un X-Forwarded-Proto de un proxy delante (Traefik), se respeta. Si no hay
# proxy adelante (compose standalone, sin Traefik), se cae al esquema propio de nginx.
map $http_x_forwarded_proto $proxy_forwarded_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

server {
  listen 80;
  server_name localhost;

  root /usr/share/nginx/html;
  index index.html;

  # DNS interno de Docker: re-resuelve el backend cada 10s.
  resolver 127.0.0.11 valid=10s ipv6=off;

  location /api/ {
    # BACKEND_UPSTREAM se resuelve via envsubst al arrancar el contenedor (ver Dockerfile).
    # Default "backend:8090" para el compose standalone; en un stack compartido (por
    # ejemplo el del Sistema de Gestion de Obras) se sobreescribe con el nombre real
    # del servicio, para no depender de que se llame justo "backend".
    set $upstream http://${BACKEND_UPSTREAM};
    proxy_pass $upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $proxy_forwarded_proto;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
