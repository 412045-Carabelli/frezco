# Si viene un X-Forwarded-Proto de un proxy delante (Traefik), se respeta. Si no hay
# proxy adelante (compose standalone, sin Traefik), se cae al esquema propio de nginx.
map $http_x_forwarded_proto $proxy_forwarded_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

server {
  listen 80;
  server_name localhost;

  root /usr/share/nginx/html;
  index index.html;

  # DNS interno de Docker: re-resuelve el backend cada 10s.
  resolver 127.0.0.11 valid=10s ipv6=off;

  location /api/ {
    # Va al API Gateway compartido (Path=/api/frezco/** alla), no directo al backend de
    # Frezco: el Gateway valida el JWT e inyecta los headers de identidad que el backend
    # necesita (GatewayAuthFilter). GATEWAY_UPSTREAM se resuelve via envsubst; solo
    # funciona si este contenedor esta en la misma red Docker que el Gateway.
    set $upstream_gateway http://${GATEWAY_UPSTREAM};
    proxy_pass $upstream_gateway;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $proxy_forwarded_proto;
  }

  location /auth/ {
    # El login pega contra el API Gateway compartido de Buildr (auth-service detras),
    # no contra el backend de Frezco. GATEWAY_UPSTREAM se resuelve via envsubst; solo
    # funciona si este contenedor esta en la misma red Docker que el Gateway.
    set $upstream_gateway http://${GATEWAY_UPSTREAM};
    proxy_pass $upstream_gateway;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $proxy_forwarded_proto;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
